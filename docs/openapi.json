{
  "openapi": "3.1.0",
  "info": {
    "title": "Sistema de Reservas de Hotel",
    "version": "1.0.0",
    "description": "API académica Facade con estado en memoria. Sin autenticación. Se reinicia al reiniciar el proceso."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Entorno local"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "health",
        "summary": "Consultar el estado del servicio",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "El backend está activo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/hotel/reservar": {
      "post": {
        "operationId": "createReservation",
        "summary": "Crear reserva",
        "tags": [
          "Hotel"
        ],
        "responses": {
          "201": {
            "description": "Operación completada correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationResponse"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Ruta para consultar la reserva creada.",
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Recurso inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto de disponibilidad o estado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "415": {
            "description": "Tipo de contenido no admitido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Error interno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservationRequest"
              }
            }
          }
        }
      }
    },
    "/api/hotel/disponibilidad": {
      "get": {
        "operationId": "availability",
        "summary": "Consultar disponibilidad y cotización",
        "tags": [
          "Hotel"
        ],
        "responses": {
          "200": {
            "description": "Operación completada correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Recurso inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto de disponibilidad o estado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "415": {
            "description": "Tipo de contenido no admitido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Error interno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "checkInDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "checkOutDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "roomType",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/RoomType"
            }
          },
          {
            "name": "season",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Season",
              "default": "LOW"
            }
          }
        ]
      }
    },
    "/api/hotel/servicios/{reservationId}": {
