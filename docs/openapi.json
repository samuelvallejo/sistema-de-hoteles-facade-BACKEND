  },
  "components": {
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UP"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "message"
        ]
      },
      "RoomType": {
        "type": "string",
        "enum": [
          "SINGLE",
          "DOUBLE",
          "SUITE"
        ]
      },
      "Season": {
        "type": "string",
        "enum": [
          "HIGH",
          "LOW"
        ]
      },
      "ServiceType": {
        "type": "string",
        "enum": [
          "SPA",
          "BREAKFAST",
          "TRANSFER"
        ]
      },
      "ReservationStatus": {
        "type": "string",
        "enum": [
          "CONFIRMED",
          "CHECKED_IN",
          "CHECKED_OUT"
        ]
      },
      "GuestRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "document": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "phone": {
            "type": "string",
            "pattern": "^[+0-9() .-]{7,25}$"
          }
        },
        "required": [
          "name",
          "document",
          "email",
          "phone"
        ],
        "additionalProperties": false
      },
      "Guest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "document": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "phone": {
            "type": "string",
            "pattern": "^[+0-9() .-]{7,25}$"
          }
        },
        "required": [
          "name",
          "document",
          "email",
          "phone"
        ]
      },
      "ReservationRequest": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "integer",
            "minimum": 1
          },
          "checkInDate": {
            "type": "string",
            "format": "date"
          },
          "checkOutDate": {
            "type": "string",
            "format": "date"
          },
          "season": {
            "$ref": "#/components/schemas/Season"
          },
          "guest": {
            "$ref": "#/components/schemas/GuestRequest"
          }
        },
        "required": [
          "roomId",
          "checkInDate",
          "checkOutDate",
          "season",
          "guest"
        ],
        "additionalProperties": false
      },
      "ServiceRequest": {
        "type": "object",
        "properties": {
          "serviceType": {
            "$ref": "#/components/schemas/ServiceType"
          }
        },
        "required": [
          "serviceType"
        ],
        "additionalProperties": false
      },
      "Room": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "number": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/RoomType"
          },
          "baseRate": {
            "type": "number",
            "description": "Importe en USD con dos decimales.",
            "multipleOf": 0.01
          }
        },
        "required": [
          "id",
          "number",
          "type",
          "baseRate"
        ]
      },
      "Rate": {
        "type": "object",
        "properties": {
          "nights": {
            "type": "integer",
            "format": "int64"
          },
          "season": {
            "$ref": "#/components/schemas/Season"
          },
          "baseNightlyRate": {
            "type": "number",
            "description": "Importe en USD con dos decimales.",
            "multipleOf": 0.01
          },
          "nightlyRate": {
            "type": "number",
            "description": "Importe en USD con dos decimales.",
            "multipleOf": 0.01
          },
          "baseTotal": {
            "type": "number",
            "description": "Importe en USD con dos decimales.",
            "multipleOf": 0.01
          },
          "seasonSurcharge": {
            "type": "number",
            "description": "Importe en USD con dos decimales.",
            "multipleOf": 0.01
          },
          "total": {
            "type": "number",
            "description": "Importe en USD con dos decimales.",
            "multipleOf": 0.01
          }
        },
        "required": [
          "nights",
          "season",
          "baseNightlyRate",
          "nightlyRate",
          "baseTotal",
          "seasonSurcharge",
          "total"
        ]
      },
      "AdditionalService": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ServiceType"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int64"
          },
          "unitPrice": {
            "type": "number",
            "description": "Importe en USD con dos decimales.",
            "multipleOf": 0.01
          },
          "total": {
            "type": "number",
            "description": "Importe en USD con dos decimales.",
            "multipleOf": 0.01
          }
        },
        "required": [
          "type",
          "description",
          "quantity",
          "unitPrice",
          "total"
        ]
      },
      "InvoiceLine": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int64"
          },
          "unitPrice": {
            "type": "number",
            "description": "Importe en USD con dos decimales.",
            "multipleOf": 0.01
          },
          "total": {
            "type": "number",
            "description": "Importe en USD con dos decimales.",
            "multipleOf": 0.01
          }
        },
        "required": [
          "description",
          "quantity",
          "unitPrice",
          "total"
        ]
      },
      "Invoice": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reservationId": {
            "type": "string",
            "format": "uuid"
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvoiceLine"
            }
          },
          "subtotal": {
            "type": "number",
            "description": "Importe en USD con dos decimales.",
            "multipleOf": 0.01
          },
          "total": {
            "type": "number",
            "description": "Importe en USD con dos decimales.",
            "multipleOf": 0.01
          }
        },
        "required": [
          "id",
          "reservationId",
          "issuedAt",
          "currency",
          "lines",
          "subtotal",
          "total"
        ]
      },
      "Availability": {
        "type": "object",
        "properties": {
          "room": {
            "$ref": "#/components/schemas/Room"
          },
          "rate": {
            "$ref": "#/components/schemas/Rate"
          }
        },
        "required": [
          "room",
          "rate"
        ]
      },
      "Reservation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "guest": {
            "$ref": "#/components/schemas/Guest"
          },
          "room": {
            "$ref": "#/components/schemas/Room"
          },
          "checkInDate": {
            "type": "string",
            "format": "date"
          },
          "checkOutDate": {
            "type": "string",
            "format": "date"
          },
          "rate": {
            "$ref": "#/components/schemas/Rate"
          },
          "status": {
            "$ref": "#/components/schemas/ReservationStatus"
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdditionalService"
            }
          },
          "servicesTotal": {
            "type": "number",
            "description": "Importe en USD con dos decimales.",
            "multipleOf": 0.01
          },
          "total": {
            "type": "number",
            "description": "Importe en USD con dos decimales.",
            "multipleOf": 0.01
          },
          "digitalKey": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "invoice": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Invoice"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "guest",
          "room",
          "checkInDate",
          "checkOutDate",
          "rate",
          "status",
          "services",
          "servicesTotal",
          "total",
          "digitalKey",
          "invoice"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "timestamp",
          "status",
          "code",
          "message",
          "path",
          "errors"
        ]
      },
      "ReservationResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/Reservation"
          }
        },
        "required": [
          "message",
          "data"
        ]
      },
      "AvailabilityResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Availability"
            }
          }
        },
        "required": [
          "message",
          "data"
        ]
      }
    }
  }
}
